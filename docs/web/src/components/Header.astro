---
import { Icon } from '@astrojs/starlight/components';
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import ThemeSelect from "./ThemeSelect.astro";

import config from '../../config';
---

<div class="header">
  <div class="title-section">
    <SiteTitle />
  </div>
  <div class="right-section">
    <div class="search-container color-text">
      <Search />
    </div>
    <a class="github-link" href={config.github} target="_blank">
      <Icon name="github" size="1rem" />
    </a>
    <ThemeSelect />
  </div>
</div>


<style>
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 100%;
  gap: 1rem;
}

.title-section {
  flex: 0 0 auto;
}

.right-section {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-left: auto;
}

.search-container {
  display: flex;
  align-items: center;
  min-width: 240px;
}

.github-link {
  display: flex;
  align-items: center;
  text-decoration: none;
  color: var(--color-text-secondary);
  padding: 0.5rem;
  border-radius: 0.375rem;
  transition: all 0.2s ease;
}

.github-link:hover {
  background-color: var(--sl-color-gray-6);
  color: var(--sl-color-text-accent);
}

.github-link svg {
  width: 1rem;
  height: 1rem;
}

/* Responsive design */
@media (max-width: 768px) {
  .right-section {
    gap: 0.5rem;
  }
  
  .search-container {
    min-width: 180px;
  }
}

@media (max-width: 640px) {
  .right-section {
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }
  
  .search-container {
    min-width: 160px;
  }
}
</style>
