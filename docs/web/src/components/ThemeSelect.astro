---
import { Icon } from '@astrojs/starlight/components';
---

<div class="theme-selector-container">
  <button
    id="theme-toggle-btn"
    class="theme-toggle-btn"
    aria-label="Toggle theme"
    aria-expanded="false"
  >
    <Icon name="sun" class="theme-icon light-icon" />
    <Icon name="moon" class="theme-icon dark-icon" />
  </button>
  
  <div id="theme-dropdown" class="theme-dropdown" aria-hidden="true">
    <button class="theme-option" data-theme="light">
      <Icon name="sun" class="option-icon" />
      <span>Light</span>
    </button>
    <button class="theme-option" data-theme="dark">
      <Icon name="moon" class="option-icon" />
      <span>Dark</span>
    </button>
    <button class="theme-option" data-theme="system">
      <Icon name="laptop" class="option-icon" />
      <span>System</span>
    </button>
  </div>
</div>

<style>
  .theme-selector-container {
    position: relative;
  }

  .theme-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: auto;
    padding: 0.5rem;
    border: none;
    border-radius: 0.375rem;
    background-color: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--color-text-secondary);
  }

  .theme-toggle-btn:hover {
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-text-accent);
  }

  .theme-toggle-btn:focus-visible {
    outline: 1px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .theme-icon {
    width: 1rem;
    height: 1rem;
  }

  /* Show appropriate icon based on theme */
  :root:not([data-theme="dark"]) .dark-icon {
    display: none;
  }

  :root[data-theme="dark"] .light-icon {
    display: none;
  }

  .theme-dropdown {
    position: absolute;
    top: calc(100% + 0.2rem);
    right: 0;
    z-index: 50;
    min-width: 10rem;
    padding: 0.2rem;
    background-color: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-md);
    border-radius: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.2rem);
    transition: all 0.2s ease;
  }

  .theme-dropdown[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.375rem 0.75rem;
    margin-bottom: 0.125rem;
    border: none;
    border-radius: 0.375rem;
    background-color: transparent;
    color: var(--sl-color-text);
    font-size: 0.8125rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  
  .theme-option:last-child {
    margin-bottom: 0;
  }

  .theme-option:hover {
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-text-accent);
  }

  .theme-option:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }

  .theme-option.active {
    background-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .option-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  /* Light mode adjustments */
  :root[data-theme="light"] .theme-dropdown {
    background-color: var(--sl-color-bg);
    backdrop-filter: blur(8px);
  }

  :root[data-theme="light"] .theme-option:hover {
    background-color: var(--sl-color-gray-7);
  }

  :root[data-theme="light"] .theme-option.active {
    background-color: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  /* Click outside to close */
  .theme-backdrop {
    position: fixed;
    inset: 0;
    z-index: 40;
  }
</style>

<script>
  // Theme selector functionality
  (() => {
    const button = document.getElementById('theme-toggle-btn') as HTMLButtonElement;
    const dropdown = document.getElementById('theme-dropdown') as HTMLElement;
    const options = document.querySelectorAll('.theme-option') as NodeListOf<HTMLButtonElement>;
    let backdrop: HTMLDivElement | null = null;
    
    const savedTheme = localStorage.getItem('theme');
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    let currentTheme = savedTheme || 'system';

    function isOpen(): boolean {
      return dropdown.getAttribute('aria-hidden') === 'false';
    }

    function openDropdown() {
      dropdown.setAttribute('aria-hidden', 'false');
      button.setAttribute('aria-expanded', 'true');
      
      // Create backdrop
      backdrop = document.createElement('div');
      backdrop.className = 'theme-backdrop';
      backdrop.addEventListener('click', () => closeDropdown());
      document.body.appendChild(backdrop);
      
      // Focus first option
      options[0].focus();
    }

    function closeDropdown() {
      dropdown.setAttribute('aria-hidden', 'true');
      button.setAttribute('aria-expanded', 'false');
      
      // Remove backdrop
      if (backdrop) {
        backdrop.remove();
        backdrop = null;
      }
      
      // Return focus to button
      button.focus();
    }

    function toggleDropdown() {
      if (isOpen()) {
        closeDropdown();
      } else {
        openDropdown();
      }
    }

    function updateTheme(theme: string) {
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const resolvedTheme = theme === 'system' ? systemTheme : theme;
      
      document.documentElement.classList.remove('light', 'dark');
      document.documentElement.classList.add(resolvedTheme);
      document.documentElement.setAttribute('data-theme', resolvedTheme);
    }

    function updateActiveOption() {
      options.forEach(option => {
        if (option.dataset.theme === currentTheme) {
          option.classList.add('active');
        } else {
          option.classList.remove('active');
        }
      });
    }

    function selectTheme(theme: string) {
      currentTheme = theme;
      updateTheme(theme);
      updateActiveOption();
      closeDropdown();
      localStorage.setItem('theme', theme);
    }

    // Initialize
    updateTheme(currentTheme);
    updateActiveOption();

    // Event listeners
    button.addEventListener('click', () => toggleDropdown());
    
    options.forEach(option => {
      option.addEventListener('click', () => {
        const theme = option.dataset.theme!;
        selectTheme(theme);
      });
    });

    // Handle system theme changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (currentTheme === 'system') {
        updateTheme('system');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        closeDropdown();
      }
    });
  })();
</script>
